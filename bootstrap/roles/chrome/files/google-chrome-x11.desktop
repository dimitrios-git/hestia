[Desktop Entry]
Version=1.0
Name=Google Chrome
Comment=Access the Internet
Exec=env PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin google-chrome-stable --ozone-platform=x11 %U
Icon=google-chrome
Terminal=false
Type=Application
Categories=Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml_xml;x-scheme-handler/http;x-scheme-handler/https;
StartupWMClass=google-chrome
