#!/usr/bin/env python3
"""hestia-type — human-timed text/key input for hestia-shot's record mode.

Companion to user/bin/hestia-shot (docs/video-capture-design.md): drives
wtype with per-character timing shaped like a real typist instead of a flat
`-d N` delay — jitter around a target WPM, an extra beat after spaces, a
longer beat after punctuation, a small tax on shifted characters.

Usage (inside a HESTIA_HOOK):
  hestia-type [OPTIONS] ACTION [ACTION ...]

Each ACTION is one of:
  text:STRING   type STRING with human-like per-character timing
  key:NAME      press a named key once (wtype -k NAME)
  pause:MS      pause for MS milliseconds, no keystroke (wtype -s MS)

Example — the vim-hello-world demo, by hand vs. via this tool:
  hand-tuned (docs/video-capture-design.md's first pass):
    wtype -d 55 "vvim -u rig.vim hello.txt" -k Return -s 1200 -k i -s 400 \\
      -d 70 "Hello world!" -s 800 -k Escape -s 600 ":wq" -k Return
  via this tool:
    hestia-type 'text:vim -u rig.vim hello.txt' key:Return pause:1200 \\
      key:i pause:400 'text:Hello world!' pause:800 key:Escape pause:600 \\
      'text::wq' key:Return

ALL actions are sent as ONE wtype invocation — never one wtype call per
action. Caught live building the vim-hello-world demo: hestia-shot's nested
headless rig drops a unit of input under some as-yet-not-fully-pinned-down
condition related to resuming after a `-s` pause. Two rounds of live
evidence on this, pointing different directions:

- **Round 1** (this tool's original build): a version that only compensated
  the sequence's opening unit worked on a pause-free run of text, then
  silently lost the "-" in "-u" the instant per-word pauses were added
  mid-text. Read at the time as "every `-s` pause is its own drop boundary,"
  so the tool was built to double the unit after EVERY pause.
- **Round 2** (generating the actual vim-hello-world demo, 2026-08-18): that
  default did the OPPOSITE of help — real characters came out visibly
  doubled ("vim -u rig.vim hello.txt" became "vim --u rrig.vvim
  hhello.ttxt"). Turning compensation off entirely and re-running the exact
  same call showed only ONE unit lost, ever: the very first one sent in the
  whole invocation — not one after any later pause, word-boundary pauses
  mid-text included.

Those two findings contradict each other, and there's no confirmed root
cause to arbitrate between them (compositor scheduling jitter under
different system load is the leading guess, not a diagnosis) — so rather
than pick one and silently drop the other's evidence, both compensation
strategies are available:

- **`--drop-compensation opener`** (the DEFAULT) — double only the very
  first unit of the whole invocation. This is what round 2 actually needed
  and verified end-to-end (the published vim-hello-world demo was recorded
  this way).
- **`--drop-compensation every-pause`** — the original, stronger behaviour:
  double the unit after EVERY `-s` pause. Reach for this if a mid-sequence
  drop resurfaces (round 1's failure mode) — the DEFAULT above will not
  catch that case.
- **`--drop-compensation none`** (same as the old `--no-drop-compensation`,
  kept as an alias) — no doubling at all. Use when driving a REAL desktop
  directly: identical calls there never drop anything, confirmed both
  rounds, so any compensation there just shows up as a visible stray
  duplicate (or, for a mode-toggle key, undoes itself).

Don't mix `every-pause` compensation into a run where only the opener
actually drops — that's exactly what produced the doubled "vim --u
rrig.vvim hhello.ttxt" above.

Options:
  --wpm N                  target words-per-minute (default 280 — a fast,
                            confident typist; try 140-180 for a more
                            hesitant/learning feel)
  --jitter F                relative per-character timing jitter, 0-1
                            (default 0.35)
  --seed N                  RNG seed, for a reproducible take
  --drop-compensation MODE  opener (default) | every-pause | none (see above)
  --no-drop-compensation    deprecated alias for --drop-compensation none
  --dry-run                 print the wtype argv instead of running it
"""
import argparse
import random
import subprocess
import sys

WORD_PAUSE_MS = (30, 160)      # extra pause after a space
PUNCT_PAUSE_MS = (150, 420)    # extra pause after . , ! ? : ;
SHIFT_EXTRA_MS = (10, 40)      # extra pause for a character that needs Shift
MIN_CHAR_MS = 18
PUNCT_CHARS = set(".,!?:;")
SHIFT_CHARS = set('~!@#$%^&*()_+{}|:"<>?')


def char_delay(ch, avg_ms, jitter, rng):
    d = rng.gauss(avg_ms, avg_ms * jitter)
    if ch.isupper() or ch in SHIFT_CHARS:
        d += rng.uniform(*SHIFT_EXTRA_MS)
    return max(MIN_CHAR_MS, d)


def parse_actions(raw):
    actions = []
    for item in raw:
        kind, sep, val = item.partition(":")
        if not sep or kind not in ("text", "key", "pause"):
            sys.exit(f"hestia-type: bad action {item!r} (want text:/key:/pause:)")
        actions.append((kind, val))
    return actions


def build_argv(actions, wpm, jitter, rng, drop_compensation):
    """drop_compensation is one of "opener" (default), "every-pause", or
    "none" — see the module docstring for the two contradictory live
    findings behind why this is a choice rather than one hardcoded rule.
    "opener" arms compensation once, before anything is sent, and consumes
    it on the very first emitted unit. "every-pause" re-arms it after every
    `-s`, whether an explicit pause: action or this tool's own automatic
    word/punctuation one, so every post-pause unit gets doubled — the
    stronger, riskier-to-overcorrect-with mode.
    """
    avg_ms = 60000 / (wpm * 5)  # ~5 chars/word, the standard WPM convention
    argv = []
    needs_comp = drop_compensation != "none"  # armed before anything is sent too

    def add_pause(ms):
        nonlocal needs_comp
        argv.extend(["-s", str(int(ms))])
        if drop_compensation == "every-pause":
            needs_comp = True

    def emit(unit):
        nonlocal needs_comp
        if needs_comp:
            argv.extend(unit)  # sacrificial — the drop eats this one
            needs_comp = False
        argv.extend(unit)

    for kind, val in actions:
        if kind == "pause":
            add_pause(val)
        elif kind == "key":
            emit(["-k", val])
        elif kind == "text":
            for ch in val:
                d = int(char_delay(ch, avg_ms, jitter, rng))
                if ch == "-":
                    # wtype reserves a BARE "-" positional argument as its own
                    # "read text from stdin" placeholder ("Stdin place-holder
                    # can only appear once" — a hard error, not a silent
                    # misread) — and per-character splitting means a lone "-"
                    # in the middle of typed text (e.g. "-u") is exactly that
                    # bare form. -k minus sidesteps it entirely (a named
                    # keysym, never mistaken for the placeholder).
                    emit(["-k", "minus"])
                else:
                    emit(["-d", str(d), ch])
                if ch == " ":
                    add_pause(rng.uniform(*WORD_PAUSE_MS))
                elif ch in PUNCT_CHARS:
                    add_pause(rng.uniform(*PUNCT_PAUSE_MS))
    return argv


def main():
    ap = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    ap.add_argument("--wpm", type=float, default=280)
    ap.add_argument("--jitter", type=float, default=0.35)
    ap.add_argument("--seed", type=int, default=None)
    ap.add_argument("--drop-compensation", choices=("opener", "every-pause", "none"), default="opener")
    ap.add_argument("--no-drop-compensation", action="store_true",
                     help="deprecated alias for --drop-compensation none")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("actions", nargs="+")
    args = ap.parse_args()

    drop_compensation = "none" if args.no_drop_compensation else args.drop_compensation
    rng = random.Random(args.seed)
    actions = parse_actions(args.actions)
    argv = build_argv(actions, args.wpm, args.jitter, rng, drop_compensation)

    if args.dry_run:
        print("wtype", " ".join(argv))
        return
    subprocess.run(["wtype", *argv], check=True)


if __name__ == "__main__":
    main()
