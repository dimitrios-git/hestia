#!/bin/bash
# start-sway — the Sway session launcher. greetd runs this via
# `tuigreet … --cmd start-sway` (see /etc/greetd/config.toml, which is still a manual
# step). It sets the Wayland session environment, then execs sway.
#
# On a host with an NVIDIA GPU AND another GPU (AMD/Intel) present, sway renders
# on the OTHER GPU while NVIDIA is kept purely as a scanout target (wlroots'
# built-in multi-GPU "reverse PRIME" support) for any monitors wired to it — see
# the "GPU render-path selection" block below. The NVIDIA-only workarounds
# further down apply ONLY when NVIDIA is the sole live GPU. That keeps this one
# script correct on AMD/Intel-only machines too — where GBM_BACKEND=nvidia-drm
# and __GLX_VENDOR_LIBRARY_NAME=nvidia would otherwise break rendering.
#
# Tracked at system/sway-session/start-sway.j2; RENDERED to /usr/local/bin/start-sway
# by the `sway_session` bootstrap role (the XCURSOR_THEME below follows `theme_variant`).
# Edit the tracked template + re-run the role to apply.

# --- generic Wayland session env (every GPU) ----------------------------------
export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=sway
export XDG_CURRENT_DESKTOP=sway
export MOZ_ENABLE_WAYLAND=1
# NB: GTK_THEME is deliberately NOT exported. GTK3 apps follow the gsettings
# `gtk-theme` (hestia-dark/hestia) the theme fragment sets at login — gsettings is
# NOT ignored in a sway session (the old belief was a misdiagnosis: the launcher's
# former `GTK_THEME=Adwaita:dark` was *overriding* gsettings, masking it). Worse,
# a set GTK_THEME makes GTK4/libadwaita apps STOP following the portal color-scheme
# and render light (file-roller's Compress dialog was the live case). With GTK_THEME
# unset, GTK3 themes via gsettings and GTK4 via color-scheme — both dark, consistent.
# See docs/theming.md (GTK section).

# Mouse cursor for everything that reads Xcursor conventions (XWayland, Qt,
# SDL, …): KDE Breeze — white (Breeze_Light) on the dark desktop, standard
# Breeze on light. sway's own cursor + GTK get the same theme from the sway
# theme fragment (seat xcursor_theme + the gsettings exec) — keep in sync.
export XCURSOR_THEME={{ 'breeze_cursors' if theme_variant == 'light' else 'Breeze_Light' }}
export XCURSOR_SIZE=24

# Qt/KDE: point Qt at KDE's platform-theme plugin (plasma-integration) so Qt apps
# read ~/.config/kdeglobals — the rendered hestia scheme (qt_theme role). Without a
# platform theme, KDE apps that don't self-apply a scheme (dolphin, krusader — unlike
# kdenlive, which activates its ColorSchemePath itself) fall back to Qt's dark-Fusion
# palette with the stock blue highlight, ignoring kdeglobals entirely; bare-Qt apps
# get kdeglobals this way too (the once-deferred qt6ct track, resolved). Guarded on
# the plugin actually being installed — with the env set but the plugin absent, Qt
# logs a warning per launch and themes nothing.
if ls /usr/lib/*/qt6/plugins/platformthemes/KDEPlasmaPlatformTheme* >/dev/null 2>&1; then
    export QT_QPA_PLATFORMTHEME=kde
fi

# Make the SSH agent reachable by every app sway `exec`s (wofi launches, GUI git
# clients, IDEs pushing over ssh, …). The credential-unlock hook warms id_dimitrios
# into the agent at this deterministic socket; exporting the var HERE — before sway,
# and even before the socket exists — means GUI apps inherit it. Without this, the
# var only lives in ~/.bashrc, so terminal ssh works but sway-launched apps silently
# fall back to "no agent" (the bug behind the Zabbix-PWA launcher needing its own
# SSH_AUTH_SOCK line).
export SSH_AUTH_SOCK="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/openssh_agent"

# --- GPU render-path selection -------------------------------------------------
# Prefer rendering on any non-NVIDIA GPU (AMD/Intel) when one is present alongside
# an NVIDIA card, while still letting NVIDIA scan out any monitors physically wired
# to it (wlroots' built-in multi-GPU "reverse PRIME" support — the secondary GPU
# gets its own local renderer purely to import/texture the primary GPU's rendered
# buffers for its own scanout, not to render the desktop itself). Root-caused +
# live-tested 2026-08-22 on hephaestus (AMD Raphael iGPU + NVIDIA RTX 4060):
#
#   - With NVIDIA as the wlroots render GPU, Chrome/Chromium windows would
#     intermittently go fully blank (repaint only on mouse movement) or render
#     text at the wrong position — worse than, and a different bug from, the
#     hover/repaint flicker already fixed by forcing XWayland (see the
#     NVIDIA-only block below). Rendering via the non-NVIDIA GPU instead (Mesa)
#     fixes it outright — confirmed on that GPU's own outputs.
#   - A monitor scanned out via NVIDIA (reverse PRIME) still shows a residual
#     flicker even with the non-NVIDIA GPU rendering — a related but distinct
#     issue, most likely the same implicit-sync weakness in this driver (550.163,
#     predates EGL_ANDROID_native_fence_sync) affecting NVIDIA's own scanout/
#     present path regardless of which GPU rendered the buffer.
#     WLR_RENDERER=vulkan does NOT help here (confirmed) — Vulkan's device
#     selection ignores WLR_RENDER_DRM_DEVICE entirely and just grabs the
#     discrete GPU (NVIDIA), reintroducing the original bug. Accepted as an
#     unfixed limitation for now, same category as the residual XWayland
#     flicker below.
#
# Both GPUs are listed in WLR_DRM_DEVICES (non-NVIDIA first) so NVIDIA's own
# outputs still get scanned/used — excluding it entirely would mean any monitor
# physically wired to NVIDIA goes dark. WLR_RENDER_DRM_DEVICE pins the actual
# compositor renderer to the non-NVIDIA GPU's RENDER node specifically (not its
# card node — wlroots rejects a non-render DRM node there); without it wlroots
# picks a GPU's boot_vga/BIOS-primary flag as a tiebreak for the renderer,
# independent of WLR_DRM_DEVICES listing order (confirmed live — NVIDIA was
# boot_vga on this host, so simply listing the other GPU first was NOT enough on
# its own). --unsupported-gpu stays mandatory even though NVIDIA isn't the
# renderer: sway's proprietary-driver guard (sway/server.c, detect_proprietary)
# fires on ANY DRM device it opens that reports the nvidia-drm driver, regardless
# of which GPU ends up rendering.
other_gpu_card=""
other_gpu_render=""
nvidia_card=""
for vendor_file in /sys/class/drm/card[0-9]/device/vendor; do
    card_dev_dir=$(dirname "$vendor_file")
    card_path="/dev/dri/$(basename "$(dirname "$card_dev_dir")")"
    if [ "$(cat "$vendor_file" 2>/dev/null)" = "0x10de" ]; then
        [ -z "$nvidia_card" ] && nvidia_card="$card_path"
        continue
    fi
    if [ -z "$other_gpu_card" ]; then
        other_gpu_card="$card_path"
        pci_path=$(readlink -f "$card_dev_dir")
        for render_dir in /sys/class/drm/renderD*; do
            if [ "$(readlink -f "$render_dir/device")" = "$pci_path" ]; then
                other_gpu_render="/dev/dri/$(basename "$render_dir")"
                break
            fi
        done
    fi
done

nvidia_live=false
{ [ -e /dev/nvidia0 ] || grep -qE '^nvidia ' /proc/modules 2>/dev/null; } && nvidia_live=true

sway_args=()
if [ -n "$other_gpu_card" ] && [ -n "$other_gpu_render" ] && [ -n "$nvidia_card" ] && [ "$nvidia_live" = true ]; then
    export WLR_DRM_DEVICES="$other_gpu_card:$nvidia_card"
    export WLR_RENDER_DRM_DEVICE="$other_gpu_render"
    export WLR_NO_HARDWARE_CURSORS=1
    sway_args+=(--unsupported-gpu)
# --- NVIDIA-only workarounds (applied only when NVIDIA is the sole live GPU) ---
elif [ "$nvidia_live" = true ]; then
    export NVIDIA_DRIVER_CAPABILITIES=all
    export GBM_BACKEND=nvidia-drm
    export __GLX_VENDOR_LIBRARY_NAME=nvidia
    export WLR_NO_HARDWARE_CURSORS=1
    # Explicit-sync fix attempt for GL-Wayland flicker on NVIDIA — TRIED, REVERTED
    # (2026-08), RE-ENABLED (2026-08). The base trixie driver (550) lacks
    # EGL_ANDROID_native_fence_sync, so wlroots' default GLES2 renderer falls back
    # to implicit sync, which NVIDIA handles poorly. WLR_RENDERER=vulkan was meant
    # to sidestep that via NVIDIA's Vulkan timeline semaphores.
    #
    # UPDATE 2026-08-10: this has never been confirmed to actually fix anything it
    # was tried against. video-compare's flicker persisted regardless (a SEPARATE
    # sync domain — its own SDL2/GL context, not wlroots' compositing — fixed
    # instead by forcing SDL_RENDER_DRIVER=software, see the `video_compare`
    # role). Steam never needed it either (its crash/corruption was fixed by
    # forcing XWayland, unrelated to the renderer; its residual webview flicker
    # has no fix at all). And Chrome/Edge/Chromium — the ORIGINAL justification —
    # were live-tested still flickering on hover with this presumably active. That
    # flicker turned out to be a completely different bug: Chromium's
    # native-Wayland Ozone backend itself (not GPU rendering — ruled out by
    # --disable-gpu not helping either), fixed by forcing XWayland instead (see
    # the `chrome`/`edge`/`chromium_x11` roles + CLAUDE.md's Chromium-family
    # XWayland gotcha). So every case in this family has actually been fixed by
    # getting the CLIENT off the GPU/native-Wayland path, never by this line.
    # Left in place because removing it isn't confirmed safe either (Steam's
    # first XWayland-corruption bug predates having a fix for it) — not because
    # it's known to help. Re-comment if a future case regresses under it.
    export WLR_RENDERER=vulkan
    # Escape hatches if a release misbehaves on NVIDIA (uncomment as needed):
    #export SWAY_IGNORE_NVIDIA=1
    # XWAYLAND_NO_GLAMOR=1 forces XWayland to composite X11 client buffers via
    # software instead of its GPU-accelerated `glamor` path. TRIED 2026-08-10
    # after forcing Chrome/Edge/Chromium through XWayland (above) surfaced a
    # diagonal-tear artifact there (window split into two triangles) — appeared
    # to fix it in an initial spot-check, but a FULL RE-LOGIN retest (fresh
    # XWayland spawn, so the var was genuinely live) showed the same family of
    # occasional flickering persisting regardless. FALSE POSITIVE — reverted to
    # a commented-out escape hatch, same as --disable-gpu-compositing in the
    # browsers' own wrapper scripts (also tried, also a false positive, also
    # reverted — see the `chrome`/`edge`/`chromium_x11` roles). Only
    # --ozone-platform=x11 is a confirmed fix in this whole investigation; the
    # residual occasional flicker on XWayland is an ACCEPTED, unfixed
    # limitation — see CLAUDE.md's Chromium-family XWayland gotcha.
    #export XWAYLAND_NO_GLAMOR=1
    sway_args+=(--unsupported-gpu)
fi

exec sway "${sway_args[@]}"
