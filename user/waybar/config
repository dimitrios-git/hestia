{
    "layer": "top",
    "position": "top",
    "height": 32,
    "modules-left": ["custom/launcher", "sway/workspaces", "sway/mode"],
    "modules-center": ["sway/window"],
    "modules-right": ["tray", "custom/cpu", "memory", "custom/gpu", "power-profiles-daemon", "custom/audio", "custom/language", "custom/network", "bluetooth", "custom/usb", "custom/notifications", "custom/weather", "custom/clock", "custom/power"],

    "custom/gpu": {
        "format": "<span size='xx-large' rise='-3072'>󰢮</span> {}",
        "return-type": "json",
        "interval": 2,
        "exec": "$HOME/.config/waybar/scripts/gpu.sh",
        "on-click": "swaymsg -t get_tree | grep -q floatterm-gpu && swaymsg '[app_id=\"^floatterm-gpu$\"] kill' || alacritty --class floatterm-gpu -e $HOME/.config/waybar/scripts/gpu-watch.sh"
    },

    "power-profiles-daemon": {
        "format": "<span size='xx-large' rise='-3072'>{icon}</span>",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "tooltip": true,
        "format-icons": {
            "default": "󰓅",
            "performance": "󰓅",
            "balanced": "󰾅",
            "power-saver": "󰌪"
        }
    },

    "bluetooth": {
        "format": "<span size='x-large' rise='-2560'>󰂯</span>",
        "format-disabled": "<span size='x-large' rise='-2560'>󰂲</span>",
        "format-off": "<span size='x-large' rise='-2560'>󰂲</span>",
        "format-connected": "<span size='x-large' rise='-2560'>󰂱</span> {num_connections}",
        "tooltip-format": "{controller_alias}\t{status}",
        "tooltip-format-connected": "{controller_alias}\t{status}\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "pgrep -u $USER -x bluetuith >/dev/null && pkill -u $USER -x bluetuith || alacritty --class floatterm -e bluetuith",
        "on-click-right": "rfkill toggle bluetooth"
    },

    // Replaces the built-in `network` module -- feature-matches its 3 states
    // via nmcli, but drops wifi's signal percentage to icon-only on a narrow
    // bar (lib-density.sh). Ethernet/disconnected were already icon-only.
    "custom/network": {
        "format": "{}",
        "return-type": "json",
        "interval": 5,
        "exec": "$HOME/.config/waybar/scripts/network.sh",
        "on-click": "pgrep -u $USER -x nmtui >/dev/null && pkill -u $USER -x nmtui || alacritty --class floatterm -e nmtui"
    },

    // Replaces the built-in `sway/language` module -- drops the layout code
    // to icon-only on a narrow bar (lib-density.sh).
    "custom/language": {
        "format": "{}",
        "return-type": "json",
        "interval": 2,
        "exec": "$HOME/.config/waybar/scripts/language.sh",
        "on-click": "swaymsg input type:keyboard xkb_switch_layout next"
    },


    // "format": "{name}" strips the leading "num:" block prefix each
    // output's own 1-10 workspace set uses (user/sway/config) -- every
    // monitor's bar shows a clean 1-10 regardless of which global block
    // (11-20, 21-30, ...) it's actually using underneath.
    "sway/workspaces": {
        "disable-scroll": true,
        "format": "{name}"
    },

    "custom/cpu": {
        "format": "<span size='xx-large' rise='-3072'>󰻠</span> {}",
        "return-type": "json",
        "interval": 2,
        "exec": "$HOME/.config/waybar/scripts/cpu.sh",
        "on-click": "pgrep -u $USER -x htop >/dev/null && pkill -u $USER -x htop || alacritty --class floatterm -e htop"
    },

    "memory": {
        "format": "<span size='xx-large' rise='-3072'>󰍛</span> {used:>4.1f}G",
        "interval": 2,
        "tooltip-format": "RAM  {used:0.1f} / {total:0.1f} GiB ({percentage}%)\nfree {avail:0.1f} GiB · swap {swapUsed:0.1f} / {swapTotal:0.1f} GiB",
        "on-click": "pgrep -u $USER -x htop >/dev/null && pkill -u $USER -x htop || alacritty --class floatterm -e htop"
    },

    "custom/audio": {
        "format": "{}",
        "return-type": "json",
        "interval": 1,
        "signal": 8,
        "exec": "$HOME/.config/waybar/scripts/audio.sh",
        "on-click": "$HOME/.config/waybar/scripts/audio.sh toggle-mute",
        "on-click-right": "$HOME/.config/waybar/scripts/audio.sh mixer",
        "on-scroll-up": "$HOME/.config/waybar/scripts/audio.sh up",
        "on-scroll-down": "$HOME/.config/waybar/scripts/audio.sh down"
    },

    // Replaces the built-in `clock` module -- drops the date, then seconds,
    // on a narrow bar (lib-density.sh). Calendar is a keyboard-driven
    // floatterm (calendar.sh), not waybar's own tooltip-format calendar --
    // that one only opens on hover and only navigates by mouse-scroll. Click
    // here, or $mod+t from anywhere (user/sway/config), toggle the same window.
    "custom/clock": {
        "format": "{}",
        "return-type": "json",
        "interval": 1,
        "exec": "$HOME/.config/waybar/scripts/clock.sh",
        "on-click": "swaymsg -t get_tree | grep -q floatterm-calendar && swaymsg '[app_id=\"^floatterm-calendar$\"] kill' || alacritty --class floatterm-calendar -e $HOME/.config/waybar/scripts/calendar.sh"
    },

    "custom/usb": {
        "format": "<span size='x-large' rise='-2560'>󰋊</span> {}",
        "return-type": "json",
        "interval": 5,
        "exec": "$HOME/.config/waybar/scripts/usb.sh",
        "on-click": "$HOME/.config/waybar/scripts/usb.sh menu"
    },

    "custom/notifications": {
        "format": "<span size='xx-large' rise='-3072'>󰂜</span>",
        "tooltip-format": "Notifications",
        "on-click": "swaymsg -t get_tree | grep -q floatterm-notify && swaymsg '[app_id=\"^floatterm-notify$\"] kill' || alacritty --class floatterm-notify -e $HOME/.config/waybar/scripts/notifications.sh show"
    },

    "custom/weather": {
        "format": "{}",
        "return-type": "json",
        "interval": 1800,
        "exec": "$HOME/.config/waybar/scripts/weather.sh",
        "on-click": "swaymsg -t get_tree | grep -q floatterm-weather && swaymsg '[app_id=\"^floatterm-weather$\"] kill' || alacritty --class floatterm-weather -e $HOME/.config/waybar/scripts/weather.sh show"
    },

    "custom/launcher": {
        "format": "<span size='xx-large' rise='-3072'></span>",
        "tooltip-format": "Applications",
        "on-click": "pgrep -u $USER -x wofi >/dev/null && pkill -u $USER -x wofi || wofi --show drun"
    },

    "custom/power": {
        "format": "<span size='xx-large' rise='-3072'>󰐥</span>",
        "tooltip-format": "Power",
        "on-click": "$HOME/.config/waybar/scripts/power.sh menu"
    },

    "tray": {
        "spacing": 10
    }
}
