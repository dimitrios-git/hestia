// hestia zellij config — terminal-multiplexer evaluation runner-up
// (enable_multiplexers; see docs/roadmap.md "Multiplexer" + showcase/multiplexer.md
// for the full trial — tmux won on manual control + Sway-`$mod` muscle memory,
// but zellij's out-of-the-box pane ergonomics were genuinely nicer, so it's kept
// installed and themed alongside tmux, same treatment ranger/yazi got after vifm
// won the file-manager evaluation).
//
// Custom hestia theme — hand-authored, see hestia-{dark,light}.kdl
// (docs/theming.md); the bootstrap symlinks the theme_variant one to
// ~/.config/zellij/themes/hestia.kdl, auto-loaded by zellij from that
// directory. Variant-blind reference here, same shape as vifm's
// `colorscheme hestia`.
theme "hestia"

// Mouse click/drag to select panes and resize; wheel to scroll.
mouse_mode true

// Wayland clipboard (matches vifm/wofi/etc — see the wl-clipboard apt package).
copy_command "wl-copy"

// Native session persistence — zellij's built-in equivalent of tmux-resurrect:
// exited sessions are cached and can be resurrected (layout, panes, cwds, and
// the commands to re-run) via the session-manager or `zellij attach`.
session_serialization true
serialize_pane_viewport true
