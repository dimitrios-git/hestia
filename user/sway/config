### Variables

set $mod Mod4

# 2px matches wofi's window border (user/wofi/style.css) — the launcher reads
# as focused when open, so the frames should weigh the same.
default_border pixel 2
for_window [app_id=".*"] border pixel 2
for_window [class=".*"] border pixel 2
# Floating popups for tray/widget click actions (nmtui, etc.). The app_id criterion is
# an unanchored regex, so it also matches the per-widget classes (floatterm-gpu,
# floatterm-weather, …). The weather forecast is wide, so size that one larger (a later
# matching rule's `resize set` wins).
for_window [app_id="floatterm"] floating enable, resize set 800 600
for_window [app_id="floatterm-weather"] resize set 1180 720
for_window [app_id="floatterm-gpu"] resize set 1100 700
for_window [app_id="floatterm-calendar"] resize set 201 295

# MEGAsync (the `mega` role — XWayland, class "MEGAsync"): force its windows
# TILED. Its setup wizard / infoDialog are frameless Qt windows that reposition
# themselves relative to a system-tray anchor on each step; on sway that geometry
# lands OFF-SCREEN, so the window "vanishes" the moment you click a button (it's
# still in the tree, just moved out of view). Floating = sway honours those bad
# coordinates; tiled = sway pins the window into the layout and IGNORES the app's
# position requests, so it can't wander off-screen and stays usable through login
# + sync setup. Some residual FLICKER remains (the app keeps re-requesting the
# off-screen move; sway overrides each frame) — cosmetic, and setup is one-time
# (afterwards MEGAsync lives in the waybar tray, syncing in the background).
# (Trade-off: the left-click tray popup also tiles rather than floating by the
# tray — unusual but visible; manage sync via right-click tray → Settings, a
# normal window.) Class match (XWayland), not app_id.
for_window [class="MEGAsync"] floating disable

# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l
set $term alacritty
set $menu wmenu-run

# Colors — GENERATED variant fragment (user/sway/theme-{dark,light}.conf,
# rendered by themes/hestia/render.py; the bootstrap symlinks the
# `theme_variant` one to ~/.config/sway/theme.conf). Defines the $colour vars,
# the desktop background, and the per-variant gsettings execs (color-scheme /
# gtk-theme). Edit palette.yml + re-render, not the fragment.
include ~/.config/sway/theme.conf

# Window colors:          border    bg        text       indicator  child_border
# ($focus = the variant's cyan, from the theme fragment — focus reads apart
# from the violet accent surfaces; urgent keeps the accent)
client.focused            $focus    $surface  $text      $focus     $focus
client.focused_inactive   $border   $bg       $dim       $border    $border
client.unfocused          $border   $bg       $dim       $border    $border
client.urgent             $accent   $accent   $accent_fg $accent    $accent

include /etc/sway/config-vars.d/*

### Output configuration

# Identify monitors by serial (both are DELL U3219Q) so the layout is
# correct regardless of which DisplayPort socket each one is plugged into.
set $mon1 "Dell Inc. DELL U3219Q 6L1L413"
set $mon2 "Dell Inc. DELL U3219Q 567V413"
# Add $mon3/$mon4/$mon5 here when those displays arrive -- get each one's
# identifier via `swaymsg -t get_outputs`, then mirror the `output ...` and
# `workspace N:M output ...` block below for it (workspaces 31:1-40:10,
# 41:1-51:10, ...). Nothing else needs to change: workspace-here.sh (bound
# below) computes which block to use from live output position, not a
# hardcoded monitor count.

output $mon1 resolution 3840x2160 position 0,0 scale 1
output $mon2 resolution 3840x2160 position 3840,0 scale 1
# (the `output * bg` desktop background lives in the theme fragment above)

# Each monitor gets its OWN full 1-10 workspace set, not a shared 10-way
# split (the old "odd -> left, even -> right" scheme, which only gives 5
# workspaces per screen and doesn't scale past 2 monitors). The leading
# number (11-20 for monitor 1, 21-30 for monitor 2, ...) is a `num:name`
# sway workspace name -- globally unique so sway treats each as a genuinely
# separate workspace, but the NAME after the colon is what waybar's
# sway/workspaces module displays (`"format": "{name}"`, user/waybar/
# config), so every monitor's bar shows a clean 1-10 regardless of which
# block it's actually using underneath. $mod+1..0 (below) computes the
# right block for whichever output is currently focused, so the same
# physical key always means "workspace N of the screen I'm on."
workspace 11:1 output $mon1
workspace 12:2 output $mon1
workspace 13:3 output $mon1
workspace 14:4 output $mon1
workspace 15:5 output $mon1
workspace 16:6 output $mon1
workspace 17:7 output $mon1
workspace 18:8 output $mon1
workspace 19:9 output $mon1
workspace 20:10 output $mon1
workspace 21:1 output $mon2
workspace 22:2 output $mon2
workspace 23:3 output $mon2
workspace 24:4 output $mon2
workspace 25:5 output $mon2
workspace 26:6 output $mon2
workspace 27:7 output $mon2
workspace 28:8 output $mon2
workspace 29:9 output $mon2
workspace 30:10 output $mon2

# Land each output on its OWN "1" at boot, instead of sway's generic
# auto-numbering fallback. The `workspace N:M output ...` lines above are
# an ASSIGNMENT (where a workspace goes IF it gets created) — they don't
# make sway switch to one at startup. Without an explicit switch, sway
# still auto-creates plain "1" on the first output (then "2" on the
# second, its own fallback numbering, oblivious to our num:name scheme)
# the moment anything needs a workspace there — so the first real
# $mod+1 press creates a GENUINELY SEPARATE "11:1" alongside the stale
# "1", and both display as the same "1" in waybar (format strips the
# num: prefix), looking like a duplicate that has to be cleaned up by
# hand (caught live: exactly this, after the per-monitor redesign).
# Switching here, before anything else opens a window, means sway's own
# fallback numbering never gets a chance to create anything in the first
# place — an empty, unfocused workspace is auto-destroyed by sway itself.
# `exec`, not `exec_always`: this sets the BOOT default only, it
# shouldn't yank focus away from wherever the user is on every
# `$mod+Shift+c` config reload. Add one more `exec swaymsg workspace
# N1:1` line here for $mon3/4/5 when those displays arrive, matching the
# workspace-assignment block above.
exec swaymsg workspace 11:1
exec swaymsg workspace 21:1

gaps inner 8
# The top edge keeps the same 8px gutter as the tiles, so windows never touch
# Waybar (until 2026-07 a `gaps top -8` cancelled it for a flush look — dropped
# with the wallpaper work, where breathing room around tiles is the point).
# smart_gaps stays OFF for the same reason: it would collapse ALL gaps on
# single-window workspaces, putting that lone window flush against the bar
# (and edge-to-edge over the wallpaper) again.
smart_gaps off

### Input configuration

# Bulgarian uses the traditional phonetic variant (W -> в); the comma
# positions in xkb_variant align variants to their layouts in xkb_layout.
# Alt+Shift cycles layouts. Caps Lock is stock (no remap).
input type:keyboard {
    xkb_layout "us,de,gr,bg"
    xkb_variant ",,,phonetic"
    xkb_options grp:alt_shift_toggle
}

### Key bindings

# Basics
    bindsym $mod+Return exec $term
    bindsym $mod+Shift+q kill
    # Launcher — TOGGLE like the waybar popups/qalc: a re-press closes the open
    # wofi instead of stacking another (wofi has no built-in single-instance).
    bindsym $mod+d exec sh -c 'pgrep -u "$USER" -x wofi >/dev/null && pkill -u "$USER" -x wofi || wofi --show drun'
    # Music: cava visualizer stacked over cmus. Alacritty has no kitty-style
    # --session/layout feature, so this is rebuilt on tmux (hestia's default
    # multiplexer) instead — see user/alacritty/music-session.sh. Idempotent: a
    # second $mod+m attaches the running session rather than stacking a
    # duplicate; quitting cmus tears the whole thing down.
    bindsym $mod+m exec alacritty -e $HOME/.config/alacritty/music-session.sh
    # Calculator: qalc (Qalculate CLI) in a floatterm — the floatterm app_id
    # triggers the `floating enable, resize set 800 600` rule above. Toggles like
    # the waybar widgets (pgrep -x): a second $mod+c closes it instead of stacking.
    bindsym $mod+c exec pgrep -u "$USER" -x qalc >/dev/null && pkill -u "$USER" -x qalc || alacritty --class floatterm -e qalc
    # Calendar: same floatterm-calendar toggle as the waybar clock's on-click
    # (user/waybar/config) — h/l/j/k-navigable, no mouse needed. A second
    # $mod+t closes it instead of stacking, matching the other toggles here.
    bindsym $mod+t exec swaymsg -t get_tree | grep -q floatterm-calendar && swaymsg '[app_id="^floatterm-calendar$"] kill' || alacritty --class floatterm-calendar -e $HOME/.config/waybar/scripts/calendar.sh

    # Drag floating windows with $mod + left mouse, resize with $mod + right.
    floating_modifier $mod normal

    bindsym $mod+Shift+c reload
    # -s renames the dismiss button (default is a bare 'X') to pair with the Yes.
    bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit' -s 'No'

# Moving around
    bindsym $mod+$left focus left
    bindsym $mod+$down focus down
    bindsym $mod+$up focus up
    bindsym $mod+$right focus right
    # Bare arrows are deliberately NOT aliases of h/j/k/l here (unlike
    # every other direction bind in this file) -- they switch the focused
    # OUTPUT (monitor) instead, native sway, no scripting needed. h/j/k/l
    # stay pure window-focus; this is the one place the two differ.
    bindsym $mod+Left focus output left
    bindsym $mod+Down focus output down
    bindsym $mod+Up focus output up
    bindsym $mod+Right focus output right

    # Move the focused window with the same, but add Shift
    bindsym $mod+Shift+$left move left
    bindsym $mod+Shift+$down move down
    bindsym $mod+Shift+$up move up
    bindsym $mod+Shift+$right move right
    bindsym $mod+Shift+Left move left
    bindsym $mod+Shift+Down move down
    bindsym $mod+Shift+Up move up
    bindsym $mod+Shift+Right move right

# Workspaces -- each monitor has its own full 1-10 set (see the Output
# configuration block above), so $mod+N goes to workspace N OF WHICHEVER
# OUTPUT IS CURRENTLY FOCUSED, not a single global workspace N. Switch
# monitor first ($mod+Left/Right/Up/Down, above), then $mod+N reaches that
# screen's own workspace N.
    bindsym $mod+1 exec $HOME/.config/sway/scripts/workspace-here.sh 1
    bindsym $mod+2 exec $HOME/.config/sway/scripts/workspace-here.sh 2
    bindsym $mod+3 exec $HOME/.config/sway/scripts/workspace-here.sh 3
    bindsym $mod+4 exec $HOME/.config/sway/scripts/workspace-here.sh 4
    bindsym $mod+5 exec $HOME/.config/sway/scripts/workspace-here.sh 5
    bindsym $mod+6 exec $HOME/.config/sway/scripts/workspace-here.sh 6
    bindsym $mod+7 exec $HOME/.config/sway/scripts/workspace-here.sh 7
    bindsym $mod+8 exec $HOME/.config/sway/scripts/workspace-here.sh 8
    bindsym $mod+9 exec $HOME/.config/sway/scripts/workspace-here.sh 9
    bindsym $mod+0 exec $HOME/.config/sway/scripts/workspace-here.sh 0
    # Move focused container to workspace N of the focused output
    bindsym $mod+Shift+1 exec $HOME/.config/sway/scripts/workspace-here.sh 1 move
    bindsym $mod+Shift+2 exec $HOME/.config/sway/scripts/workspace-here.sh 2 move
    bindsym $mod+Shift+3 exec $HOME/.config/sway/scripts/workspace-here.sh 3 move
    bindsym $mod+Shift+4 exec $HOME/.config/sway/scripts/workspace-here.sh 4 move
    bindsym $mod+Shift+5 exec $HOME/.config/sway/scripts/workspace-here.sh 5 move
    bindsym $mod+Shift+6 exec $HOME/.config/sway/scripts/workspace-here.sh 6 move
    bindsym $mod+Shift+7 exec $HOME/.config/sway/scripts/workspace-here.sh 7 move
    bindsym $mod+Shift+8 exec $HOME/.config/sway/scripts/workspace-here.sh 8 move
    bindsym $mod+Shift+9 exec $HOME/.config/sway/scripts/workspace-here.sh 9 move
    bindsym $mod+Shift+0 exec $HOME/.config/sway/scripts/workspace-here.sh 0 move

# Layout
    # $mod+b / $mod+v split horizontally / vertically
    bindsym $mod+b splith
    bindsym $mod+v splitv

    bindsym $mod+s layout stacking
    bindsym $mod+w layout tabbed
    bindsym $mod+e layout toggle split

    bindsym $mod+f fullscreen
    bindsym $mod+Shift+space floating toggle
    bindsym $mod+space focus mode_toggle
    bindsym $mod+a focus parent

# Scratchpad
    bindsym $mod+Shift+minus move scratchpad
    bindsym $mod+minus scratchpad show

# Resizing containers
mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px

    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# Utilities
    bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle && pkill -RTMIN+8 -x waybar
    bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- && pkill -RTMIN+8 -x waybar
    bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ && pkill -RTMIN+8 -x waybar
    bindsym XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
