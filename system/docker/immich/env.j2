{{ ansible_managed | comment }}
# Rendered by the `docker_services` role -> /opt/immich/.env (mode 0600).
# CARRIES A SECRET (DB_PASSWORD, from gitignored host_vars). Do not edit in place.
# Docs: https://docs.immich.app/install/environment-variables

# Immich's own storage: uploads, thumbnails, previews, transcoded video.
UPLOAD_LOCATION={{ immich_upload_location }}
{% if immich_external_library | length > 0 and immich_upload_location.startswith(immich_external_library ~ '/') %}
# NOTE: this path is nested INSIDE the external library ({{ immich_external_library }}),
# so the library in the UI must exclude it with the pattern **/{{ immich_upload_location | basename }}/**
# or Immich will index its own generated thumbnails as new assets.
{% endif %}

# Postgres data. Must be local SSD -- never a network share or a mergerfs pool.
DB_DATA_LOCATION={{ immich_db_data_location }}

TZ={{ docker_timezone }}

# Pin to a tag like "v3.1.0" for reproducible restarts; "release" is rolling and can
# cross a major version (with one-way database migrations) on a `docker compose pull`.
IMMICH_VERSION={{ immich_version }}

DB_PASSWORD={{ immich_db_password }}

# The values below this line do not need to be changed
###################################################################################
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
