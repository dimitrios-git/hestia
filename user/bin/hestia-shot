#!/usr/bin/env bash
# hestia-shot — headless-sway screenshot rig (docs/claude-env-parity-design.md, Tier B).
#
# Reproduce a themed hestia desktop/TUI screenshot with NO live graphical session —
# built for the `claude` agent (headless) to re-shoot showcase images faithfully.
# It spins up a throwaway nested sway on the wlroots *headless* backend (software
# pixman renderer — no GPU/DRM needed), paints the hestia theme + mesh wallpaper,
# launches the scene, captures it with grim, and tears the whole thing down.
#
# Reads its configs from the repo clone it lives in (claude's workspace = the branch
# under review), so a shot reflects whatever you're working on. Self-contained: it
# stages a temp waybar dir (resolving the theme-<variant> pair to the plain `theme`
# name the way the bootstrap symlink does), so nothing needs deploying first.
#
# Usage:
#   hestia-shot <scene> [output.png|output.mp4] [path]
# Scenes:
#   desktop            waybar + mesh wallpaper + tiled vifm (the full composite)
#   vifm [path]        vifm alone (default path: the repo)
#   ranger | yazi      that file manager alone
#   app "<command>"    any command in a themed alacritty (e.g. app "cmus")
#   vim "<vim args>"   plain vim with the repo's hestia colorscheme, BORDERLESS —
#                      the alacritty window is fullscreened in the nested sway, so the
#                      shot is exactly the terminal surface (no sway border, no
#                      wallpaper gaps). This is the hestia.vim screenshot scene.
#                      e.g.  vim "+15 sample.py"  or  vim "-d old.py new.py"
#                      Relative paths resolve against your cwd (vim inherits it,
#                      so the statusline shows the bare filename). Default res
#                      840x540 — override with HESTIA_RES (vimdiff wants ~1280x620).
#
# CAPTURE MODE is inferred from the output's extension — no separate flag:
#   .png (default)  single grim shot, after the settle + optional HESTIA_HOOK
#   .mp4/.mkv/.webm wf-recorder bracketed AROUND the settle + HESTIA_HOOK, so the
#                    whole scripted action sequence gets captured, not just the
#                    end state. With no HESTIA_HOOK, records HESTIA_DURATION
#                    seconds (default 5) of the scene as-is (e.g. ambient motion).
#                    docs/video-capture-design.md — layer 1 of the video pipeline.
#
# Env overrides: HESTIA_REPO, HESTIA_VARIANT (dark|light), HESTIA_RES (WxH),
#                HESTIA_DURATION (record mode, no-hook seconds, default 5).
set -euo pipefail

# INCIDENT (2026-08-24): run from a terminal INSIDE a real, live sway
# session (dimitrios, not claude's always-headless account), this script
# inherits a SWAYSOCK from that real session — sway exports it for every
# child process. If the script errors out at ANY point before it finishes
# discovering and assigning the nested rig's OWN socket further down, the
# cleanup trap's `[ -n "${SWAYSOCK:-}" ] && swaymsg exit` still sees that
# inherited, non-empty value and exits the real compositor — which is
# exactly what happened: dropped straight back to the greeter. Unsetting
# it here means the trap only ever acts on a socket THIS script itself
# verified belongs to its own throwaway compositor. WAYLAND_DISPLAY is the
# same class of inherited variable (sway exports it too) — nothing below
# currently trusts it before the WD set-difference resolution overwrites
# it, but unset it too rather than leave that an invariant future edits
# have to remember not to break.
unset SWAYSOCK WAYLAND_DISPLAY

REPO="${HESTIA_REPO:-$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)}"
# When run from the deployed symlink (~/.local/bin/hestia-shot -> repo/user/bin),
# readlink resolves into the clone, so REPO is the clone root. Fall back to the
# known shared clone if that ever fails.
[ -d "$REPO/user" ] || REPO=/srv/devshare/hestia
VARIANT="${HESTIA_VARIANT:-dark}"
RES="${HESTIA_RES:-1920x1080}"
SCENE="${1:-desktop}"
OUT="${2:-$PWD/hestia-shot.png}"
: "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"
export XDG_RUNTIME_DIR

U="$REPO/user"
WANT_BAR=0
# vifm scenes launch with a fixed server name so a post-map hook can drive them
# (e.g. `vifm --server-name "$VIFM_SHOT_SERVER" --remote -c :gs` to reach a state
# before the capture). Export it for HESTIA_HOOK.
export VIFM_SHOT_SERVER=hestiashot
VIFM="vifm --server-name $VIFM_SHOT_SERVER"
# WAIT_MATCH = the app_id (prefix) to wait for before capturing; SETTLE = extra
# seconds for the app to paint (browsers/WebGL need longer than a TUI).
WAIT_MATCH=term; SETTLE=1

# The workdir exists before the scene case so scenes can stage files into it
# (the vim scene writes its rig vimrc here).
WORK=$(mktemp -d "${TMPDIR:-/tmp}/hestia-shot.XXXXXX")
cleanup() {
  # A still-running recorder (script errored mid-recording) must die BEFORE
  # sway does — killing sway out from under it would drop the container's
  # trailer, corrupting the mp4, instead of wf-recorder's own clean finalize.
  if [ -n "${WFPID:-}" ] && kill -0 "$WFPID" 2>/dev/null; then
    kill -INT "$WFPID" 2>/dev/null
    for _ in $(seq 1 20); do kill -0 "$WFPID" 2>/dev/null || break; sleep 0.1; done
  fi
  # Graceful first (`swaymsg exit` closes waybar + the app), then let
  # dbus-run-session exit on its own so it REAPS its dbus-daemon — a straight
  # group kill orphans that daemon (they pile up and wedge later chromium runs).
  # Only group-kill (waybar/alacritty are grandchildren of dbus-run-session, missed
  # by a plain launcher kill) if it hasn't exited within ~2s.
  [ -n "${SWAYSOCK:-}" ] && swaymsg exit >/dev/null 2>&1 || true
  if [ -n "${SWAYPID:-}" ]; then
    for _ in $(seq 1 20); do kill -0 "$SWAYPID" 2>/dev/null || break; sleep 0.1; done
    kill -- "-$SWAYPID" 2>/dev/null || kill "$SWAYPID" 2>/dev/null || true
  fi
  rm -rf "$WORK" "${CHROME_PROFILE:-}"
}
trap cleanup EXIT

case "$SCENE" in
  desktop) APP="alacritty --class term -e $VIFM $U"; WANT_BAR=1 ;;
  vifm)    APP="alacritty --class term -e $VIFM ${3:-$REPO}" ;;
  ranger)  APP="alacritty --class term -e ranger ${3:-$REPO}" ;;
  yazi)    APP="alacritty --class term -e yazi ${3:-$REPO}" ;;
  app)     APP="alacritty --class term -e ${2:?scene 'app' needs a command}"; OUT="${3:-$PWD/hestia-shot.png}" ;;
  # Plain vim on the repo's colorscheme, fullscreened so the capture is exactly
  # the terminal surface — the scene hestia.vim's screenshots are shot with. The
  # rig vimrc mirrors those shots: no plugins, line numbers, cursorline, and the
  # startup file-info message cleared so the cmdline is empty.
  vim)     VIMARGS="${2:?scene 'vim' needs vim args (e.g. \"+15 sample.py\")}"; OUT="${3:-$PWD/hestia-shot.png}"
           RES="${HESTIA_RES:-840x540}"
           cat > "$WORK/rig.vim" <<EOF
set nocompatible
set runtimepath+=$U/vim
set termguicolors
set number
set cursorline
set laststatus=2
syntax on
set background=$VARIANT
colorscheme hestia
autocmd VimEnter * redraw | echo ''
EOF
           APP="alacritty --class term --working-directory $PWD -e vim -u $WORK/rig.vim $VIMARGS"
           EXTRA_CFG='for_window [app_id="^term$"] fullscreen enable' ;;
  # A URL/file rendered by chromium *inside* the nested sway, captured with grim —
  # NOT chromium's own --screenshot/headless (that path is broken in claude's env;
  # this renders to a real Wayland window instead). WebGL works via the NVIDIA EGL
  # stack (falls back to swiftshader). Used to re-shoot the flash-mesh tuning page.
  url)     URL="${2:?scene 'url' needs a URL or file path}"; OUT="${3:-$PWD/hestia-shot.png}"
           case "$URL" in *://*) ;; *) URL="file://$(readlink -f "$URL")" ;; esac
           CHROME_PROFILE=$(mktemp -d)
           APP="env __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/10_nvidia.json chromium --ozone-platform=wayland --app=$URL --user-data-dir=$CHROME_PROFILE --no-first-run --no-default-browser-check --disable-background-networking --disable-features=Translate,PushMessaging --enable-unsafe-swiftshader --use-gl=angle"
           # sway-side fullscreen (fills the output, no gaps/border) — NOT chromium's
           # own --start-fullscreen, which pops an "exit full screen" banner.
           EXTRA_CFG='for_window [app_id="^chrome-.*"] fullscreen enable'
           WAIT_MATCH=chrome; SETTLE=4 ;;
  *) echo "hestia-shot: unknown scene '$SCENE'" >&2; exit 2 ;;
esac

# --- pick a wallpaper: claude's deployed mesh, else the showcase mesh, else solid --
BG=""
for c in \
  "$HOME/.local/share/backgrounds/hestia/flash-mesh-$VARIANT-${RES/x/x}.png" \
  "$(ls -S "$HOME"/.local/share/backgrounds/hestia/*-"$VARIANT"-*.png 2>/dev/null | head -1)" \
  "$REPO/showcase/img/flash-mesh-$VARIANT.png" \
  "$REPO/showcase/img/plain-mesh-$VARIANT.png"; do
  [ -n "$c" ] && [ -f "$c" ] && { BG="$c"; break; }
done

# --- accent + ground from the generated sway theme fragment (tracks the palette) ---
THEME="$U/sway/theme-$VARIANT.conf"
ACCENT=$(sed -n 's/^set \$accent  *\(#[0-9a-fA-F]\{6\}\).*/\1/p' "$THEME" | head -1)
ACCENT_FG=$(sed -n 's/^set \$accent_fg  *\(#[0-9a-fA-F]\{6\}\).*/\1/p' "$THEME" | head -1)
GROUND=$(sed -n 's/^set \$bg  *\(#[0-9a-fA-F]\{6\}\).*/\1/p' "$THEME" | head -1)
DIM=$(sed -n 's/^set \$dim  *\(#[0-9a-fA-F]\{6\}\).*/\1/p' "$THEME" | head -1)
FOCUS=$(sed -n 's/^set \$focus  *\(#[0-9a-fA-F]\{6\}\).*/\1/p' "$THEME" | head -1)
BORDER=$(sed -n 's/^set \$border  *\(#[0-9a-fA-F]\{6\}\).*/\1/p' "$THEME" | head -1)
SURFACE=$(sed -n 's/^set \$surface  *\(#[0-9a-fA-F]\{6\}\).*/\1/p' "$THEME" | head -1)
TEXT=$(sed -n 's/^set \$text  *\(#[0-9a-fA-F]\{6\}\).*/\1/p' "$THEME" | head -1)
: "${ACCENT:=#7c3aed}"; : "${ACCENT_FG:=#ffffff}"; : "${GROUND:=#1a1a1a}"; : "${DIM:=#8c8c8c}"
: "${FOCUS:=#22cdda}"; : "${BORDER:=#3a3a3a}"; : "${SURFACE:=#262626}"; : "${TEXT:=#e0e0e0}"

# --- stage a waybar dir resolving the theme-<variant>.css pair to `theme.css` ------
if [ "$WANT_BAR" = 1 ]; then
  mkdir -p "$WORK/wb/scripts"
  cp "$U/waybar/config" "$U/waybar/style.css" "$WORK/wb/"
  cp "$U/waybar/theme-$VARIANT.css" "$WORK/wb/theme.css"
  cp "$U"/waybar/scripts/*.sh "$WORK/wb/scripts/" 2>/dev/null || true
  chmod +x "$WORK"/wb/scripts/*.sh 2>/dev/null || true
  # Rewrite every $HOME/.config/waybar/scripts reference to the staged path --
  # both in the config's own on-click/exec strings AND inside the scripts'
  # OWN internal cross-references (lib-density.sh sourcing, clock.sh's
  # calendar.sh on-click, ...), same technique already used for alacritty's
  # theme.toml import below. A HOME=<staged dir> override was tried first
  # (simpler, no sed) but broke fontconfig's Nerd Font lookup entirely --
  # every bar icon rendered as a tofu box, confirmed live by comparing
  # against a capture with $HOME untouched -- since the fonts live under the
  # REAL $HOME/.local/share/fonts, not a throwaway staged one.
  sed -i "s#\$HOME/\.config/waybar/scripts#$WORK/wb/scripts#g" \
    "$WORK/wb/config" "$WORK"/wb/scripts/*.sh
fi

# --- stage an alacritty dir resolving the theme-<variant>.toml pair to `theme.toml` -
# The scenes launch bare `alacritty`, which reads the DEPLOYED ~/.config/alacritty —
# the deployed variant, not $VARIANT, and not the branch under review. Stage the repo
# pair like waybar above — but alacritty.toml's `[general] import` is an ABSOLUTE
# path (`~/.config/alacritty/theme.toml`), unlike kitty's relative `include
# theme.conf`, so staging a plain copy would still pull the DEPLOYED theme; the
# import line itself has to be rewritten to point at the staged one.
case "$APP" in alacritty\ *)
  mkdir -p "$WORK/alacritty"
  sed "s|~/.config/alacritty/theme.toml|$WORK/alacritty/theme.toml|" \
    "$U/alacritty/alacritty.toml" > "$WORK/alacritty/alacritty.toml"
  cp "$U/alacritty/theme-$VARIANT.toml" "$WORK/alacritty/theme.toml"
  APP="alacritty --config-file $WORK/alacritty/alacritty.toml ${APP#alacritty }"
;; esac

# --- the throwaway rig sway config ------------------------------------------------
CFG="$WORK/rig-sway.conf"
{
  echo "output HEADLESS-1 resolution $RES position 0,0"
  if [ -n "$BG" ]; then echo "output HEADLESS-1 bg $BG fill"
  else echo "output HEADLESS-1 bg $GROUND solid_color"; fi
  cat <<EOF
default_border pixel 2
gaps inner 8
gaps outer 8
gaps top 8
# hestia window colours — matches the deployed config's client.* lines
# exactly (<border> <background> <text> <indicator> <child_border>):
# focused uses the cyan FOCUS role, NOT the purple ACCENT role (that's
# reserved for urgent) — and unfocused/focused_inactive use the BORDER grey,
# NOT the ground colour, which made an unfocused window's border the same
# colour as the desktop behind it — invisible, not "no border" as it first
# looked. Caught live comparing a capture against a real screenshot. (\$-
# prefixed role names avoided here on purpose — this is an UNQUOTED heredoc,
# so a literal "\$focus" in a comment is not just text, it's a variable
# expansion, and set -u turns any undefined one into a hard crash.)
client.focused          $FOCUS  $SURFACE $TEXT      $FOCUS  $FOCUS
client.focused_inactive $BORDER $GROUND  $DIM       $BORDER $BORDER
client.unfocused        $BORDER $GROUND  $DIM       $BORDER $BORDER
client.urgent           $ACCENT $ACCENT  $ACCENT_FG $ACCENT $ACCENT
EOF
  # Real floatterm-* floating/sizing rules, pulled from the deployed sway
  # config rather than duplicated here — a HESTIA_HOOK that pops one (the
  # calendar, weather, gpu monitor, ...) should float exactly like it does
  # on a real desktop, not tile into the layout (caught live: a captured
  # calendar demo tiled next to vifm instead of floating centred, since this
  # throwaway rig config never had these rules at all).
  grep '^for_window \[app_id="floatterm' "$U/sway/config" || true
  # A floating window's border never painted its first frame on this
  # backend (WLR_RENDERER=pixman) when it only came from the *passive*
  # default_floating_border setting — sway's own tree state showed the
  # correct border/width the whole time (`current_border_width: 2`), so
  # this isn't a config or colour bug, it's a damage-tracking gap specific
  # to this rig: an EXPLICIT `border` COMMAND (same resulting value)
  # reliably repaints it where the passive default doesn't. Same family as
  # wf-recorder needing --no-damage above — this backend keeps missing the
  # first paint for anything that isn't triggered by a live command.
  echo 'for_window [app_id="floatterm.*"] border pixel 2'
  [ -n "${EXTRA_CFG:-}" ] && echo "$EXTRA_CFG"
  [ "$WANT_BAR" = 1 ] && echo "exec waybar -c $WORK/wb/config -s $WORK/wb/style.css"
  echo "exec sleep 0.3 && $APP"
} > "$CFG"

# Snapshot the wayland-* AND sway-ipc.*.sock sockets BEFORE launch — see the
# WD resolution below for why. `|| true`: no sockets yet (fresh boot) must
# not trip -e.
WD_BEFORE=$(ls "$XDG_RUNTIME_DIR"/wayland-* 2>/dev/null | grep -v '\.lock$' || true)
SOCK_BEFORE=$(ls "$XDG_RUNTIME_DIR"/sway-ipc.*.sock 2>/dev/null || true)

# --- launch the throwaway compositor (dbus session so waybar/portals init) --------
export WLR_BACKENDS=headless WLR_RENDERER=pixman WLR_HEADLESS_OUTPUTS=1
# setsid → own process group, so cleanup can kill the whole tree (sway + its
# dbus-session children waybar/alacritty) with one group kill.
setsid dbus-run-session -- sway -c "$CFG" >"$WORK/sway.log" 2>&1 &
SWAYPID=$!

# INCIDENT (2026-08-24): the exact same class of bug as the WD resolution
# below — but this copy went unfixed and cost dimitrios his real desktop
# session. `ls -t sway-ipc.*.sock | head -1` picks the MOST RECENTLY
# MODIFIED socket, not the new one: on claude's headless-only account
# there's only ever one candidate, so this looked correct for this entire
# rig's development — but on a machine with a real live sway session (run
# by dimitrios instead of claude), the real socket already exists and can
# win this race on an early poll, before the nested compositor has even
# created its own socket file yet. `get_version` happily succeeds against
# ANY working sway socket, real or nested, so the loop breaks thinking it
# found the rig — and every following `swaymsg`, including this script's
# own `swaymsg exit` in the cleanup trap, then talks to dimitrios's REAL
# compositor. His live session exited and dropped him back to the greeter.
# Fixed with the identical set-difference technique already used for WD.
SOCK=""
for _ in $(seq 1 50); do
  # `|| true` guards the whole pipeline: under set -euo pipefail an unmatched
  # glob makes ls fail and the failing assignment would kill the script on the
  # FIRST poll — masked until now by stale sockets from earlier sessions.
  SOCK=$(comm -13 <(printf '%s\n' "$SOCK_BEFORE") <(ls "$XDG_RUNTIME_DIR"/sway-ipc.*.sock 2>/dev/null || true) | head -1 || true)
  [ -n "$SOCK" ] && SWAYSOCK="$SOCK" swaymsg -t get_version >/dev/null 2>&1 && break
  sleep 0.1
done
[ -n "$SOCK" ] || { echo "hestia-shot: sway did not start" >&2; tail -5 "$WORK/sway.log" >&2; exit 1; }
export SWAYSOCK="$SOCK"

# Capture mode is inferred from $OUT's extension (see the usage header) — no
# separate flag, so every existing shoot invocation keeps working unchanged.
case "$OUT" in
  *.mp4 | *.mkv | *.webm) MODE=record ;;
  *)                      MODE=shoot ;;
esac

# wait for the scene window to map, then settle for the render
for _ in $(seq 1 80); do
  swaymsg -t get_tree 2>/dev/null | grep -q "\"app_id\": \"$WAIT_MATCH" && break
  sleep 0.1
done
sleep "$SETTLE"

# The nested compositor's OWN wayland-N socket, found by set difference
# against the pre-launch snapshot — NOT "first"/"most recent" of whatever's
# on disk. Both of those are unreliable on a machine that already has a real
# desktop session (exactly this case, run by dimitrios rather than the
# headless-only claude agent): a bare `ls | head -1` picks wayland-1 (the
# REAL desktop) over the nested rig's own higher-numbered socket, since
# sway/wlroots doesn't renumber sequentially from 1 when wayland-1 is
# already taken by someone else — caught LIVE capturing the real desktop
# instead of the isolated scene (docs/video-capture-design.md's phase-2
# test). Worse: wlroots' OWN reported $WAYLAND_DISPLAY in its process
# environment is STALE in this situation too (it reports the name it first
# tried, not the one it actually fell back to after the collision) — so
# reading it from /proc/$SWAYPID/environ doesn't work either. The one
# reliably correct signal is "which socket appeared that wasn't there
# before we launched this specific instance".
WD=$(comm -13 <(printf '%s\n' "$WD_BEFORE") <(ls "$XDG_RUNTIME_DIR"/wayland-* 2>/dev/null | grep -v '\.lock$') | head -1 | xargs -n1 basename)
[ -n "$WD" ] || { echo "hestia-shot: could not identify the nested compositor's own Wayland socket" >&2; exit 1; }
# EXPORTED, not just passed to grim/wf-recorder below — a HESTIA_HOOK that
# drives input (wtype, for record-mode action sequences) needs it in its own
# ambient environment too. Left unexported, a hook's `wtype` would silently
# fall back to whatever WAYLAND_DISPLAY the invoking shell already has set —
# on dimitrios's own machine, that's the REAL desktop, not this throwaway
# rig (the same class of mistake the WD-resolution bug above was).
export WAYLAND_DISPLAY="$WD"
mkdir -p "$(dirname "$OUT")"

if [ "$MODE" = record ]; then
  # wf-recorder brackets the hook, instead of running before a single grim
  # shot — the whole scripted action sequence gets captured, not just the
  # end state (docs/video-capture-design.md, layer 1). Started only after
  # the settle above, so the first recorded frame is already fully painted,
  # not a half-rendered flash.
  #
  # --no-damage is REQUIRED here, not an optimisation — caught live: without
  # it, wf-recorder's default damage-tracking captures the first frame (or
  # two) against this headless/pixman backend and then silently STOPS
  # requesting new ones, even though the scene keeps changing underneath (a
  # `grim` shot taken at the same point in an identical hook correctly shows
  # the updated state, so this is specific to wf-recorder's damage-event
  # subscription on this backend, not a rendering problem). The frozen
  # damage-tracking mode also failed to exit cleanly on SIGINT in testing;
  # --no-damage's steady polling terminated promptly every time.
  WAYLAND_DISPLAY="$WD" wf-recorder --no-damage -x yuv444p -p crf=18 -p preset=slow -f "$OUT" >"$WORK/wf-recorder.log" 2>&1 &
  WFPID=$!
  sleep 0.3   # let the encoder actually start before anything on-screen happens
  if [ -n "${HESTIA_HOOK:-}" ]; then
    eval "$HESTIA_HOOK"
  else
    sleep "${HESTIA_DURATION:-5}"
  fi
  sleep 0.3   # trailing pad, so the last action isn't cut off mid-frame
  # SIGINT, not SIGTERM/kill -9 — wf-recorder finalizes the container's
  # trailer on a clean interrupt (its own documented stop signal); anything
  # harsher risks an unplayable/truncated mp4.
  kill -INT "$WFPID" 2>/dev/null
  wait "$WFPID" 2>/dev/null || true
  echo "hestia-shot: recorded $OUT ($SCENE, $VARIANT, $RES)"
else
  # optional post-map hook — drive the scene into a specific state before the
  # shot (e.g. send vifm `--remote` commands via $VIFM_SHOT_SERVER).
  if [ -n "${HESTIA_HOOK:-}" ]; then eval "$HESTIA_HOOK"; sleep 1; fi
  sleep 0.5
  WAYLAND_DISPLAY="$WD" grim "$OUT"
  echo "hestia-shot: wrote $OUT ($SCENE, $VARIANT, $RES)"
fi
