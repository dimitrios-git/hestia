// hestia zellij theme — LIGHT variant
//
// Hand-authored per docs/theming.md's lightweight process; see hestia-dark.kdl
// for the full rationale. Roles here: text=26 26 26, bg=245 245 245,
// surface=228 228 228, surface_alt=218 218 218, accent=124 58 237 (same both
// variants), accent_fg=255 255 255, danger=215 0 0 (same both), plus the
// LIGHT-tuned ANSI green/yellow/blue/magenta/cyan (darker, for AA on a light
// ground).
themes {
    hestia {
        text_unselected {
            base 26 26 26
            background 245 245 245
            emphasis_0 124 58 237
            emphasis_1 8 122 132
            emphasis_2 35 113 51
            emphasis_3 190 7 114
        }
        text_selected {
            base 26 26 26
            background 218 218 218
            emphasis_0 124 58 237
            emphasis_1 8 122 132
            emphasis_2 35 113 51
            emphasis_3 190 7 114
        }
        ribbon_selected {
            base 255 255 255
            background 124 58 237
            emphasis_0 215 0 0
            emphasis_1 175 95 0
            emphasis_2 190 7 114
            emphasis_3 0 95 175
        }
        ribbon_unselected {
            base 26 26 26
            background 228 228 228
            emphasis_0 215 0 0
            emphasis_1 175 95 0
            emphasis_2 190 7 114
            emphasis_3 0 95 175
        }
        table_title {
            base 124 58 237
            background 0
            emphasis_0 8 122 132
            emphasis_1 35 113 51
            emphasis_2 190 7 114
            emphasis_3 175 95 0
        }
        table_cell_selected {
            base 26 26 26
            background 218 218 218
            emphasis_0 124 58 237
            emphasis_1 8 122 132
            emphasis_2 35 113 51
            emphasis_3 190 7 114
        }
        table_cell_unselected {
            base 26 26 26
            background 245 245 245
            emphasis_0 124 58 237
            emphasis_1 8 122 132
            emphasis_2 35 113 51
            emphasis_3 190 7 114
        }
        list_selected {
            base 26 26 26
            background 218 218 218
            emphasis_0 124 58 237
            emphasis_1 8 122 132
            emphasis_2 35 113 51
            emphasis_3 190 7 114
        }
        list_unselected {
            base 26 26 26
            background 245 245 245
            emphasis_0 124 58 237
            emphasis_1 8 122 132
            emphasis_2 35 113 51
            emphasis_3 190 7 114
        }
        frame_selected {
            base 124 58 237
            background 0
            emphasis_0 8 122 132
            emphasis_1 35 113 51
            emphasis_2 190 7 114
            emphasis_3 0
        }
        frame_highlight {
            base 175 95 0
            background 0
            emphasis_0 190 7 114
            emphasis_1 175 95 0
            emphasis_2 175 95 0
            emphasis_3 175 95 0
        }
        exit_code_success {
            base 35 113 51
            background 0
            emphasis_0 8 122 132
            emphasis_1 245 245 245
            emphasis_2 190 7 114
            emphasis_3 0 95 175
        }
        exit_code_error {
            base 215 0 0
            background 0
            emphasis_0 175 95 0
            emphasis_1 0
            emphasis_2 0
            emphasis_3 0
        }
        multiplayer_user_colors {
            player_1 124 58 237
            player_2 8 122 132
            player_3 35 113 51
            player_4 175 95 0
            player_5 190 7 114
            player_6 0
            player_7 215 0 0
            player_8 0
            player_9 0
            player_10 0
        }
    }
}
